digraph prerequisites {
  rankdir=LR; nodesep=0.25; ranksep=0.8; bgcolor="transparent";
  node [shape=box, fontname="Helvetica", fontsize=13, margin="0.18,0.08"];
  edge [color="#888888", fontname="Helvetica", fontsize=11, fontcolor="#555555", arrowsize=0.7];
  "license" [label="License", URL="criteria/tier-1/license.html", target="_top", tooltip="Every part of the package, code and data alike, carries an explicit license or terms of use, so others know whether and how they may use, modify and redistribute it. The authors have the right to share what they deposit.", fillcolor="#cd7f32", color="#8c5523", style="rounded,filled", penwidth=1.5]
  "code deposit" [label="Code deposit", URL="criteria/tier-1/code-deposit.html", target="_top", tooltip="All code needed to go from the data to every reported result, including data cleaning and preparation as well as the analysis, is publicly available with the paper in human-readable form, preferably in a trusted repository with a persistent identifier.", fillcolor="#cd7f32", color="#8c5523", style="rounded,filled", penwidth=1.5]
  "data deposit" [label="Data deposit", URL="criteria/tier-1/data-deposit.html", target="_top", tooltip="The data needed to reproduce the reported results are publicly available with the paper, preferably in a trusted repository with a persistent identifier. This can be the raw data, the analysis data, or both; with analysis data only, results can be reproduced from the analysis data but not from the raw data.", fillcolor="#cd7f32", color="#8c5523", style="rounded,filled", penwidth=1.5]
  "dependency resolution" [label="Dependency resolution", URL="criteria/tier-2/dependency-resolution.html", target="_top", tooltip="Every add-on package or library the code needs is declared with its exact version, ideally in a machine-readable file (e.g. renv.lock in R) or an installation script (e.g. a setup.do in Stata), so that a user can install them on a new machine and the code finds them.", fillcolor="#c0c0c0", color="#7d7f83", style="rounded,filled", penwidth=1.5]
  "path resolution" [label="Path resolution", URL="criteria/tier-2/path-resolution.html", target="_top", tooltip="The code finds its input and output files on any machine without edits: paths are relative to the package's root folder, there are no hard-coded absolute paths or machine-specific working directories, and files sit in the folders the code expects.", fillcolor="#c0c0c0", color="#7d7f83", style="rounded,filled", penwidth=1.5]
  "coding error handling" [label="Coding error handling", URL="criteria/tier-2/coding-error-handling.html", target="_top", tooltip="The code runs to completion without execution errors (bugs). The criterion also covers how errors found during a check are handled: they are recorded, the reproducer makes only minor and unambiguous fixes within a stated limit, each fix is documented, and anything larger goes back to the authors.", fillcolor="#c0c0c0", color="#7d7f83", style="rounded,filled", penwidth=1.5]
  "computing environment" [label="Computing environment", URL="criteria/tier-2/computing-environment.html", target="_top", tooltip="The system the code was run on is documented: operating system, version of the statistical software or programming language, and, where relevant, hardware and expected runtime. Ideally the environment is captured so it can be rebuilt (e.g. a container, virtual machine or cloud capsule) and the code runs the same way on another machine.", fillcolor="#c0c0c0", color="#7d7f83", style="rounded,filled", penwidth=1.5]
  "codes consistent with claims" [label="Codes consistent with claims", URL="criteria/tier-3/codes-consistent-with-claims.html", target="_top", tooltip="The code does what the paper says it does: data preparation, samples, model specifications and estimators match the description in the paper, and results are computed by the code rather than copied in. This can be checked by reading the code against the paper, without running it (i.e., static code analysis).", fillcolor="#ffd700", color="#b39500", style="rounded,filled", penwidth=1.5]
  "numerical output match" [label="Numerical output match", URL="criteria/tier-3/numerical-output-match.html", target="_top", tooltip="Re-running the code on the deposited data reproduces the numerical results reported in the paper and appendix: estimates, standard errors, test statistics, sample sizes and numbers in the text. Sources differ on the tolerance, from exact agreement to small stated deviations.", fillcolor="#ffd700", color="#b39500", style="rounded,filled", penwidth=1.5]
  "table and figure match" [label="Table and figure match", URL="criteria/tier-3/table-and-figure-match.html", target="_top", tooltip="The code regenerates every table and figure in the paper and appendix, and the regenerated items match the published ones in structure and appearance; for figures, this means the levels, shapes and positions of curves and data points.", fillcolor="#ffd700", color="#b39500", style="rounded,filled", penwidth=1.5]
  "license" -> "data deposit" [penwidth=1.64, label="3", style="solid"]
  "code deposit" -> "dependency resolution" [penwidth=2.19, label="7", style="solid"]
  "code deposit" -> "path resolution" [penwidth=2.07, label="6", style="solid"]
  "code deposit" -> "coding error handling" [penwidth=2.07, label="6", style="solid"]
  "code deposit" -> "computing environment" [penwidth=2.19, label="7", style="solid"]
  "dependency resolution" -> "computing environment" [penwidth=2.19, label="7", style="solid"]
  "code deposit" -> "codes consistent with claims" [penwidth=1.94, label="5", style="solid"]
  "code deposit" -> "numerical output match" [penwidth=3.07, label="17", style="solid"]
  "data deposit" -> "numerical output match" [penwidth=3, label="16", style="solid"]
  "coding error handling" -> "numerical output match" [penwidth=2.07, label="6", style="solid"]
  "computing environment" -> "numerical output match" [penwidth=1.94, label="5", style="solid"]
  "dependency resolution" -> "numerical output match" [penwidth=1.8, label="4", style="solid"]
  "codes consistent with claims" -> "numerical output match" [penwidth=1.64, label="3", style="solid"]
  "path resolution" -> "numerical output match" [penwidth=1.64, label="3", style="solid"]
  "code deposit" -> "table and figure match" [penwidth=2.4, label="9", style="solid"]
  "data deposit" -> "table and figure match" [penwidth=2.19, label="7", style="solid"]
  "coding error handling" -> "table and figure match" [penwidth=1.8, label="4", style="solid"]
  "computing environment" -> "table and figure match" [penwidth=1.64, label="3", style="solid"]
  "dependency resolution" -> "table and figure match" [penwidth=1.64, label="3", style="solid"]
}
