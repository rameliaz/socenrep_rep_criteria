digraph prerequisites {
  rankdir=LR; nodesep=0.25; ranksep=0.8; bgcolor="transparent";
  node [shape=box, fontname="Helvetica", fontsize=13, margin="0.18,0.08"];
  edge [color="#888888", fontname="Helvetica", fontsize=11, fontcolor="#555555", arrowsize=0.7];
  "documentation" [label="Documentation", URL="criteria/tier-1/documentation.html", target="_top", tooltip="The replication package explains its own contents: a README lists every file, describes the data and states how to run the code to reproduce the results, and a codebook or data dictionary defines each variable with its values and labels. A third party should be able to understand and use the data without contacting the authors.", fillcolor="#d9ede8", color="#2a7f6f", style="rounded,filled", penwidth=1.5]
  "data provenance" [label="Data provenance", URL="criteria/tier-1/data-provenance.html", target="_top", tooltip="The origin of every dataset used in the analysis is recorded: a citation of the source with its version or vintage, how and when the data were obtained (e.g. the query or API used), and, for data that cannot be shared, how and under what conditions others can obtain the same data. Where possible, identifiers or checksums let a user confirm they hold identical data.", fillcolor="#d9ede8", color="#2a7f6f", style="rounded,filled", penwidth=1.5]
  "license" [label="License", URL="criteria/tier-1/license.html", target="_top", tooltip="Every part of the package, code and data alike, carries an explicit license or terms of use, so others know whether and how they may use, modify and redistribute it. The authors have the right to share what they deposit.", fillcolor="#d9ede8", color="#2a7f6f", style="rounded,filled", penwidth=1.5]
  "code deposit" [label="Code deposit", URL="criteria/tier-1/code-deposit.html", target="_top", tooltip="All code needed to go from the data to every reported result, including data cleaning and preparation as well as the analysis, is publicly available with the paper in human-readable form, preferably in a trusted repository with a persistent identifier.", fillcolor="#d9ede8", color="#2a7f6f", style="rounded,filled", penwidth=1.5]
  "data deposit" [label="Data deposit", URL="criteria/tier-1/data-deposit.html", target="_top", tooltip="The data needed to reproduce the reported results are publicly available with the paper, preferably in a trusted repository with a persistent identifier. This can be the raw data, the analysis data, or both; with analysis data only, results can be reproduced from the analysis data but not from the raw data.", fillcolor="#d9ede8", color="#2a7f6f", style="rounded,filled", penwidth=1.5]
  "dependency resolution" [label="Dependency resolution", URL="criteria/tier-2/dependency-resolution.html", target="_top", tooltip="Every add-on package or library the code needs is declared with its exact version, ideally in a machine-readable file (e.g. renv.lock in R) or an installation script (e.g. a setup.do in Stata), so that a user can install them on a new machine and the code finds them.", fillcolor="#dce6f5", color="#2f5d9c", style="rounded,filled", penwidth=1.5]
  "path resolution" [label="Path resolution", URL="criteria/tier-2/path-resolution.html", target="_top", tooltip="The code finds its input and output files on any machine without edits: paths are relative to the package's root folder, there are no hard-coded absolute paths or machine-specific working directories, and files sit in the folders the code expects.", fillcolor="#dce6f5", color="#2f5d9c", style="rounded,filled", penwidth=1.5]
  "coding error handling" [label="Coding error handling", URL="criteria/tier-2/coding-error-handling.html", target="_top", tooltip="The code runs to completion without execution errors (bugs). The criterion also covers how errors found during a check are handled: they are recorded, the reproducer makes only minor and unambiguous fixes within a stated limit, each fix is documented, and anything larger goes back to the authors.", fillcolor="#dce6f5", color="#2f5d9c", style="rounded,filled", penwidth=1.5]
  "computing environment" [label="Computing environment", URL="criteria/tier-2/computing-environment.html", target="_top", tooltip="The system the code was run on is documented: operating system, version of the statistical software or programming language, and, where relevant, hardware and expected runtime. Ideally the environment is captured so it can be rebuilt (e.g. a container, virtual machine or cloud capsule) and the code runs the same way on another machine.", fillcolor="#dce6f5", color="#2f5d9c", style="rounded,filled", penwidth=1.5]
  "code runs without manual intervention" [label="Code runs without manual intervention", URL="criteria/tier-2/code-runs-without-manual-intervention.html", target="_top", tooltip="The full analysis runs from a single entry point (e.g. a master script or Makefile) in the correct order and non-interactively, with no manual steps, GUI clicks or copying of results between scripts.", fillcolor="white", color="#2f5d9c", style="rounded,dashed", penwidth=1.5]
  "code annotation" [label="Code annotation", URL="criteria/tier-2/code-annotation.html", target="_top", tooltip="The code is commented and structured so that a reader can follow what each part does: script headers state purpose, inputs and outputs, and comments show which section produces which table or figure.", fillcolor="white", color="#2f5d9c", style="rounded,dashed", penwidth=1.5]
  "dynamic code inspection" [label="Dynamic code inspection", URL="criteria/tier-2/dynamic-code-inspection.html", target="_top", tooltip="A reproducer can explore how the code behaves by running it with small modifications, inspecting intermediate results, or applying code-analysis tools.", fillcolor="white", color="#2f5d9c", style="rounded,dashed", penwidth=1.5]
  "workflow/reproduction tree" [label="Workflow/reproduction tree", URL="criteria/tier-2/workflow-reproduction-tree.html", target="_top", tooltip="The package documents which code and data files produce each table and figure in the paper, for example as a diagram or table that traces every display item back to its scripts and inputs.", fillcolor="white", color="#2f5d9c", style="rounded,dashed", penwidth=1.5]
  "codes consistent with claims" [label="Codes consistent with claims", URL="criteria/tier-3/codes-consistent-with-claims.html", target="_top", tooltip="The code does what the paper says it does: data preparation, samples, model specifications and estimators match the description in the paper, and results are computed by the code rather than copied in. This can be checked by reading the code against the paper, without running it (i.e., static code analysis).", fillcolor="#ebe1f3", color="#6b3f8f", style="rounded,filled", penwidth=1.5]
  "numerical output match" [label="Numerical output match", URL="criteria/tier-3/numerical-output-match.html", target="_top", tooltip="Re-running the code on the deposited data reproduces the numerical results reported in the paper and appendix: estimates, standard errors, test statistics, sample sizes and numbers in the text. Sources differ on the tolerance, from exact agreement to small stated deviations.", fillcolor="#ebe1f3", color="#6b3f8f", style="rounded,filled", penwidth=1.5]
  "table and figure match" [label="Table and figure match", URL="criteria/tier-3/table-and-figure-match.html", target="_top", tooltip="The code regenerates every table and figure in the paper and appendix, and the regenerated items match the published ones in structure and appearance; for figures, this means the levels, shapes and positions of curves and data points.", fillcolor="#ebe1f3", color="#6b3f8f", style="rounded,filled", penwidth=1.5]
  "third-party certification" [label="Third-party certification", URL="criteria/tier-3/third-party-certification.html", target="_top", tooltip="An independent party certifies that it reproduced the results, or specific tables and figures, from the package, for example in a signed letter or a certificate from a certification agency. This matters most when the data are confidential and reproducers cannot access them.", fillcolor="white", color="#6b3f8f", style="rounded,dashed", penwidth=1.5]
  "license" -> "code deposit" [penwidth=1.45, label="2", style="solid"]
  "license" -> "data deposit" [penwidth=1.64, label="3", style="solid"]
  "code deposit" -> "dependency resolution" [penwidth=2.19, label="7", style="solid"]
  "documentation" -> "dependency resolution" [penwidth=1.45, label="2", style="solid"]
  "data deposit" -> "dependency resolution" [penwidth=1.2, label="1", style="solid"]
  "code deposit" -> "path resolution" [penwidth=2.07, label="6", style="solid"]
  "data deposit" -> "path resolution" [penwidth=1.2, label="1", style="solid"]
  "documentation" -> "path resolution" [penwidth=1.2, label="1", style="solid"]
  "code deposit" -> "coding error handling" [penwidth=2.07, label="6", style="solid"]
  "documentation" -> "coding error handling" [penwidth=1.45, label="2", style="solid"]
  "data deposit" -> "coding error handling" [penwidth=1.2, label="1", style="solid"]
  "code deposit" -> "computing environment" [penwidth=2.19, label="7", style="solid"]
